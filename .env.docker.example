NODE_ENV=production
PORT=6859
HOST=0.0.0.0

PUBLIC_BASE_URL=http://localhost:6859
WORKSPACE_ROOT=/data/workspace
SHARE_ROOT=/data/shares
ARTIFACT_ROOT=/data/artifacts
PROJECT_ROOT=/data/projects
USERS_ROOT=/data/users
SKILL_STATE_PATH=/data/state/skill-state.json
SITE_STATE_PATH=/data/state/site-state.json
BLOG_STATE_PATH=/data/state/blog-state.json
OAUTH_STATE_PATH=/data/state/oauth-state.json
USER_STATE_PATH=/data/state/users-state.json
DATABASE_URL=postgres://coding_mcp:coding_mcp_password@postgres:5432/coding_mcp_chatgpt

# With NODE_ENV=production the dev-token OAuth bypass is DISABLED by default
# (recommended: leave it unset in production and use OAuth). To force-enable it you must
# set BOTH a 32+ char random MCP_DEV_TOKEN and MCP_DEV_TOKEN_ALLOW_PROD=true.
# MCP_DEV_TOKEN=
# MCP_DEV_TOKEN_ALLOW_PROD=false
KB_MCP_OAUTH_ENABLED=1
KB_MCP_OAUTH_ISSUER=http://localhost:6859
KB_MCP_OAUTH_PASSCODE=change-me-owner-passcode
ADMIN_PASSCODE=change-me-admin-passcode
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
COMMAND_TIMEOUT_MS=30000
CONVERSATION_FILE_MAX_BYTES=100MiB
FILE_TRANSFER_TIMEOUT_MS=300000
# Durable PostgreSQL job queue controls.
JOB_WORKER_POLL_MS=250
JOB_LEASE_MS=30000
JOB_HEARTBEAT_MS=2000
JOB_SHUTDOWN_GRACE_MS=30000
JOB_WORKER_CONCURRENCY=5
JOB_BROWSER_CONCURRENCY=2
JOB_BUILD_CONCURRENCY=2
JOB_AUDIO_CONCURRENCY=1
JOB_MAX_CONCURRENT_PER_USER=2
