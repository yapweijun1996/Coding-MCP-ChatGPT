{
  "name": "coding-mcp-chatgpt",
  "version": "0.1.0",
  "description": "Minimal ChatGPT-compatible coding MCP server with preview links.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:server && npm run build:admin",
    "build:server": "tsc",
    "build:admin": "tsc -p admin-ui/tsconfig.json --noEmit && vite build --config admin-ui/vite.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p admin-ui/tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "npm run typecheck && tsx --test --test-timeout=120000 --test-concurrency=1 tests/*.test.ts",
    "check:mcp": "npm run build && node scripts/check-mcp-registry.mjs",
    "check:tools": "npm run build:server && node scripts/check-mcp-registry.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f coding-mcp-chatgpt"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "archiver": "^8.0.0",
    "chrome-launcher": "^1.2.1",
    "express": "^4.19.2",
    "lighthouse": "^13.4.0",
    "lucide-react": "^1.20.0",
    "mp4-muxer": "^5.2.2",
    "pg": "^8.21.0",
    "playwright": "^1.61.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reveal.js": "^6.0.1",
    "three": "^0.184.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=20"
  }
}
