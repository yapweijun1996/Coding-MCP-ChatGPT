PORT=6859
HOST=127.0.0.1
PUBLIC_BASE_URL=https://gmb01.xyz
WORKSPACE_ROOT=/Users/yapweijun/Documents/GitHub/Coding-MCP-ChatGPT
SHARE_ROOT=/Users/yapweijun/Documents/GitHub/Coding-MCP-ChatGPT/.shares
PROJECT_ROOT=/Users/yapweijun/Documents/GitHub/Coding-MCP-ChatGPT/.projects
OAUTH_STATE_PATH=/Users/yapweijun/Documents/GitHub/Coding-MCP-ChatGPT/.state/oauth-state.json
# Local-only OAuth bypass. Must be a 32+ char random secret or it is ignored.
# Disabled automatically when NODE_ENV=production unless MCP_DEV_TOKEN_ALLOW_PROD=true.
MCP_DEV_TOKEN=replace-with-a-32-plus-char-random-secret
KB_MCP_OAUTH_ENABLED=1
KB_MCP_OAUTH_ISSUER=https://gmb01.xyz
KB_MCP_OAUTH_PASSCODE=change-me-owner-passcode
ADMIN_PASSCODE=change-me-admin-passcode
COMMAND_TIMEOUT_MS=30000
CONVERSATION_FILE_MAX_BYTES=100MiB
FILE_TRANSFER_TIMEOUT_MS=300000
# Durable job queue. Heartbeat must be lower than lease; aggregate worker concurrency
# should be at least the sum of the class caps to make every configured slot usable.
JOB_WORKER_POLL_MS=250
JOB_LEASE_MS=30000
JOB_HEARTBEAT_MS=2000
JOB_SHUTDOWN_GRACE_MS=30000
JOB_WORKER_CONCURRENCY=5
JOB_BROWSER_CONCURRENCY=2
JOB_BUILD_CONCURRENCY=2
JOB_AUDIO_CONCURRENCY=1
JOB_MAX_CONCURRENT_PER_USER=2
